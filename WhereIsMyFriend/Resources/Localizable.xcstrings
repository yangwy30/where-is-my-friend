    "Apple authorization is wired, but server verification is replaced by the local repository in this build." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已接入 Apple 授权；当前构建使用本地数据层代替服务器验证。" } } } },
