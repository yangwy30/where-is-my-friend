# The API has no custom development secrets. Hosted Supabase and local
# `supabase functions serve` inject these values automatically.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<local service role key from `supabase status`>

# Generate with `openssl rand -base64 32`; never expose this key to the iOS app.
APNS_DEVICE_TOKEN_KEY=
APNS_SANDBOX_BUNDLE_ID=com.yangwy30.whereismyfriend.staging
APNS_SANDBOX_URL_SCHEME=whereismyfriend-staging
APNS_PRODUCTION_BUNDLE_ID=com.yangwy30.whereismyfriend.staging
APNS_PRODUCTION_URL_SCHEME=whereismyfriend-staging

# push-worker only. Store the .p8 contents as an Edge secret, never in this repo.
PUSH_WORKER_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=93RUQ2A6KX
APNS_PRIVATE_KEY=
